<Page x:Class="UP_02_MM_Krasnova4.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP_02_MM_Krasnova4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="600"
      Title="MainPage">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock Text="Решение задач СМО" FontSize="20" Margin="30" HorizontalAlignment="Center"/>

        <!--Выбор модели-->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Text="Модель СМО" Margin="10"/>
            <ComboBox x:Name="ModelSMOCB" Width="350" Margin="10" SelectionChanged="ModelSMOCB_SelectionChanged"/>
        </StackPanel>

        <!--Колво каналов-->
        <StackPanel x:Name="nSP" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Text="Количество каналов (обслуживающих устройств), n =" Margin="10"/>
            <TextBox x:Name="nTB" Width="30" Margin="0,10,10,10"/>
        </StackPanel>

        <!--Длина очереди-->
        <StackPanel x:Name="mLenSP" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Text="Длина очереди, m =" Margin="10" ToolTip="Необязательно"/>
            <TextBox x:Name="mLenTB" Width="30" Margin="0,10,10,10"/>
        </StackPanel>

        <!--Число заявок в очереди-->
        <StackPanel x:Name="mAmountSP" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Text="Количество заявок в очереди, m =" Margin="10"/>
            <TextBox x:Name="mAmountTB" Width="30" Margin="0,10,10,10"/>
        </StackPanel>

        <!--Интенсивность потока заявок-->
        <StackPanel x:Name="lambdaSP" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Text="Интенсивность потока заявок λ =" Margin="10"/>
            <TextBox x:Name="lambdaTB" Width="30" Margin="0,10,10,10"/>
            <TextBlock Text="заявок в" Margin="0,10,10,10"/>
            <ComboBox x:Name="lambdaCB" Width="60" Margin="0,10,10,10"/>
        </StackPanel>

        <!--Интенсивность потока обслуживания-->
        <StackPanel x:Name="muSP" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock Text="Интенсивность потока обслуживания μ=" Margin="10"/>
            <TextBox x:Name="muTB" Width="30" Margin="0,10,10,10"/>
            <TextBlock Text="или tобс =" Margin="0,10,10,10"/>
            <TextBox x:Name="tobsTB" Width="30" Margin="0,10,10,10"/>
            <ComboBox x:Name="tobsCB" Width="60" Margin="0,10,10,10"/>
        </StackPanel>

        <!--Решение-->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CleanBtn" Content="Очистить" Height="20" Width="100" Margin="10" Click="CleanBtn_Click"/>
            <Button x:Name="ResultBtn" Content="Решить" Height="20" Width="100" Margin="10" Click="ResultBtn_Click"/>
        </StackPanel>



        <!--Блок с решением-->
        <StackPanel x:Name="ResultSP" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical" Visibility="Collapsed">
            <TextBlock x:Name="ResultTB" Text="" Height="auto" Width="450" Margin="10"/>
            <StackPanel HorizontalAlignment="Right">
                <Button x:Name="ExcelBtn" Content="Выгрузка в Excel" Height="20" Width="100" Margin="10" Click="ExcelBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
